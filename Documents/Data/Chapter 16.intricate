      "ports_visible": false,
      "shelf_visible": false,
      "label": "The Tale of The Sun's Love",
      "depth_front": false,
      "node_tint": "#2a3a2f"
    },
    {
      "node_id": 0,
      "node_type": "warm",
      "title": "New Thought",
      "uuid": "edbea872c0564162b4048a67f8b3dfbf",
      "x": 5148.437937960021,
      "y": -1534.9524305231444,
      "width": 327.64278182895896,
      "height": 161.9777266728933,
      "z_value": -9.978000000000012,
      "ports_visible": false,
      "shelf_visible": true,
      "body_text": "This leaves room for the actual point to come there between so in this context I will number you three\n\nAnd you have the context of getting between us\nClear mental image of a human, between two other humans distanced"
    },
