      "z_value": -9.966000000000019,
      "ports_visible": false,
      "shelf_visible": true,
      "body_text": "They both carry the same default lexicon of understanding\nAnd interpretations through life"
    },
    {
      "node_id": 0,
      "node_type": "warm",
      "title": "Golden Hour",
      "uuid": "8ecb2bba9bde4b2cabac2ca21183ef63",
      "x": 5279.23928912908,
      "y": -2069.446338009605,
      "width": 314.780797778211,
      "height": 148.04915626793314,
      "z_value": -9.98200000000001,
      "ports_visible": false,
      "shelf_visible": true,
      "body_text": "The Five, is her, again, not contextual to the other categories one, two, three, four\nAlso just an entity on its own merit\nIn it's own context"
    },
