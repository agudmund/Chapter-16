      "width": 420.0,
      "height": 342.0,
      "z_value": -9.930000000000039,
      "ports_visible": false,
      "shelf_visible": true,
      "label": "I see \u2014 `Theme.iconBorderOn` will resolve via `__getattr__` to `_MISSING_ICON` sentinel, then `Theme.icon()` will use the fallback_color. But the actual icon file needs to be found. Let me check how icon files are resolved:",
      "depth_front": false,
      "node_tint": "#2a2f3a"
    },
    {
